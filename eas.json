{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://frugal-grasshopper-744.convex.cloud",
        "EXPO_PUBLIC_DEV_TOOLS": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://frugal-grasshopper-744.convex.cloud"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://frugal-grasshopper-744.convex.cloud"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
